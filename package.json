{
  "name": "expandnote-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @expandnote/web dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @expandnote/web build",
    "test": "turbo run test",
    "test:web": "pnpm --filter @expandnote/web test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
